generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum ContactRole {
  SUPPLIER
  CUSTOMER
  BOTH
}

enum AccountRole {
  SUPPLIER
  CUSTOMER
}

model Contact {
  id        String      @id @default(cuid())
  name      String
  phone     String?
  address   String?
  role      ContactRole
  notes     String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  accounts  Account[]
  services  Service[]
}

model Account {
  id              String      @id @default(cuid())
  contactId       String
  role            AccountRole
  openingBalance  String      @default("0.00")
  currentBalance  String      @default("0.00")
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  contact         Contact     @relation(fields: [contactId], references: [id])

  @@unique([contactId, role])
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model Item {
  id            String          @id @default(cuid())
  name          String
  description   String?
  sku           String?         @unique
  unit          String          @default("piece")
  costPrice     String          @default("0.00")
  sellingPrice  String          @default("0.00")
  minStock      Int             @default(0)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  movements     StockMovement[]
}

model StockMovement {
  id        String       @id @default(cuid())
  itemId    String
  type      MovementType
  quantity  Int
  note      String?
  reference String?
  createdAt DateTime     @default(now())
  item      Item         @relation(fields: [itemId], references: [id])
}

enum PricingType {
  FIXED
  COMMISSION
}

model Service {
  id            String      @id @default(cuid())
  name          String
  description   String?
  supplierId    String
  pricingType   PricingType
  fixedProfit   String?
  commissionPct String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  supplier      Contact     @relation(fields: [supplierId], references: [id])
}
