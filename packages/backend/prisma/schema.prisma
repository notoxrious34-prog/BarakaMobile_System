generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ContactRole {
  SUPPLIER
  CUSTOMER
  BOTH
}

enum AccountRole {
  SUPPLIER
  CUSTOMER
}

model Contact {
  id          String                    @id @default(cuid())
  name        String
  phone       String?
  address     String?
  role        ContactRole
  notes       String?
  creditLimit String                    @default("0.00")
  isActive    Boolean                   @default(true)
  isWalkIn    Boolean                   @default(false)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  accounts    Account[]
  services    Service[]
  repairs     RepairTicket[]
  wallets     DigitalWallet[]
  debtLedger  CustomerDebtLedgerEntry[]
  supplierDebtLedger SupplierDebtLedgerEntry[]
  salesReturns SalesReturn[]
}

model Account {
  id              String        @id @default(cuid())
  contactId       String
  role            AccountRole
  openingBalance  String        @default("0.00")
  currentBalance  String        @default("0.00")
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  contact         Contact       @relation(fields: [contactId], references: [id])
  transactions    Transaction[]
  ledgerEntries   LedgerEntry[]
  @@unique([contactId, role])
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model Item {
  id               String            @id @default(cuid())
  name             String
  description      String?
  sku              String?           @unique
  unit             String            @default("piece")
  costPrice        String            @default("0.00")
  sellingPrice     String            @default("0.00")
  minStock         Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  movements        StockMovement[]
  transactionLines TransactionItem[]
  salesReturnItems SalesReturnItem[]
  stockCountItems  StockCountItem[]
  repairPartItems  RepairPartItem[]
}

model StockMovement {
  id        String       @id @default(cuid())
  itemId    String
  type      MovementType
  quantity  Int
  note      String?
  reference String?
  createdAt DateTime     @default(now())
  item      Item         @relation(fields: [itemId], references: [id])
}

enum PricingType {
  FIXED
  COMMISSION
}

model Service {
  id               String               @id @default(cuid())
  name             String
  description      String?
  supplierId       String
  pricingType      PricingType
  fixedProfit      String?
  commissionPct    String?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  supplier         Contact              @relation(fields: [supplierId], references: [id])
  transactionLines TransactionService[]
}

enum TransactionType {
  SALE
  PURCHASE
  PAYMENT_IN
  PAYMENT_OUT
  OFFSET
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum CashMovementType {
  IN
  OUT
}

enum CashMovementCategory {
  SALE_PAYMENT
  PURCHASE_PAYMENT
  PAYMENT_IN
  PAYMENT_OUT
  EXPENSE
  OWNER_DRAW
  OWNER_DEPOSIT
  ADJUSTMENT
  DEBT_SETTLEMENT
  SUPPLIER_PAYMENT
  REPAIR_PAYMENT
  REFUND
}

model Transaction {
  id             String               @id @default(cuid())
  type           TransactionType
  accountId      String
  amount         String
  amountPaidNow  String?              @default("0.00")
  note           String?
  reference      String?
  reversalOf     String?
  invoiceNumber  String?              @unique
  returnStatus   String               @default("NONE")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  account        Account              @relation(fields: [accountId], references: [id])
  ledgerEntries  LedgerEntry[]
  reversal       Transaction?         @relation("ReversalOf", fields: [reversalOf], references: [id])
  reversedBy     Transaction[]        @relation("ReversalOf")
  itemLines      TransactionItem[]
  serviceLines   TransactionService[]
  walletPurchases WalletLedgerEntry[] @relation("WalletPurchase")
  walletSales     WalletLedgerEntry[] @relation("WalletSale")
  debtLedgerEntries CustomerDebtLedgerEntry[]
  supplierDebtEntries SupplierDebtLedgerEntry[]
  salesReturns    SalesReturn[]
}

model LedgerEntry {
  id            String          @id @default(cuid())
  transactionId String
  accountId     String
  entryType     LedgerEntryType
  amount        String
  balanceBefore String
  balanceAfter  String
  createdAt     DateTime        @default(now())
  transaction   Transaction     @relation(fields: [transactionId], references: [id])
  account       Account         @relation(fields: [accountId], references: [id])
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  itemId        String
  quantity      Int
  unitPrice     String
  unitCost      String      @default("0.00")
  totalPrice    String
  walletServiceId       String?
  nominalAmount         String?
  walletDeductionAmount String?
  commissionProfit      String?
  beneficiaryPhone      String?
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  item          Item        @relation(fields: [itemId], references: [id])
  walletService WalletService? @relation(fields: [walletServiceId], references: [id], onDelete: SetNull)
  salesReturnItems SalesReturnItem[]
}

model TransactionService {
  id            String      @id @default(cuid())
  transactionId String
  serviceId     String
  amount        String
  profit        String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  service       Service     @relation(fields: [serviceId], references: [id])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CashAccount {
  id             String         @id @default(cuid())
  currentBalance String         @default("0.00")
  updatedAt      DateTime       @updatedAt
  movements      CashMovement[]
}

model CashMovement {
  id                   String               @id @default(cuid())
  cashAccountId        String
  type                 CashMovementType
  category             CashMovementCategory
  amount               String
  balanceBefore        String
  balanceAfter         String
  note                 String?
  relatedTransactionId String?
  relatedExpenseId     String?
  createdAt            DateTime             @default(now())
  cashAccount          CashAccount          @relation(fields: [cashAccountId], references: [id])
}

model ExpenseCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expenses    Expense[]
}

enum ExpensePaymentSource {
  REGISTER_CASH
  SAFE_VAULT
  EXTERNAL_ACCOUNT
}

model Expense {
  id               String               @id @default(cuid())
  expenseNumber    String?              @unique
  categoryId       String
  amount           String
  paymentSource    ExpensePaymentSource @default(REGISTER_CASH)
  recipientName    String?
  invoiceReference String?
  cashMovementId   String?
  description      String?
  expenseDate      DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  category         ExpenseCategory      @relation(fields: [categoryId], references: [id])
}

enum DeviceType {
  PHONE
  TABLET
  LAPTOP
  OTHER
}

enum RepairStatus {
  RECEIVED
  DIAGNOSING
  IN_REPAIR
  READY
  DELIVERED
  CANCELLED
}

enum RepairType {
  INTERNAL
  EXTERNAL
}

model RepairTicket {
  id                   String    @id @default(cuid())
  ticketNumber         String    @unique
  contactId            String
  deviceType           String
  deviceBrand          String
  deviceModel          String
  problemDescription   String
  status               String    @default("RECEIVED")
  repairType           String    @default("INTERNAL")
  technicianName       String?
  estimatedCost        String    @default("0.00")
  actualCost           String    @default("0.00")
  externalCost         String    @default("0.00")
  depositAmount        String    @default("0.00")
  depositPaid          Boolean   @default(false)
  laborCost            String    @default("0.00")
  partsCost            String    @default("0.00")
  partsTotal           String    @default("0.00")
  totalAmount          String    @default("0.00")
  discountAmount       String    @default("0.00")
  paidAmount           String    @default("0.00")
  completedAt          DateTime?
  invoiceNumber        String?   @unique
  relatedTransactionId String?
  notes                String?
  physicalCondition    String?
  hasPasscode          Boolean   @default(false)
  accessories          String?
  receivedAt           DateTime  @default(now())
  deliveredAt          DateTime?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  contact              Contact   @relation(fields: [contactId], references: [id])
  debtLedgerEntries    CustomerDebtLedgerEntry[]
  parts                RepairPartItem[]
}

model RepairPartItem {
  id               String       @id @default(cuid())
  ticketId         String
  ticket           RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  inventoryItemId  String
  inventoryItem    Item         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity         Int
  unitCostPrice    String       @default("0.00")
  unitPrice        String       @default("0.00")
  totalCost        String       @default("0.00")
  totalPrice       String       @default("0.00")
  stockMovementId  String?
  createdAt        DateTime     @default(now())

  @@index([ticketId])
  @@index([inventoryItemId])
}

enum WalletType {
  FLEXY
  GAMING
  FOREIGN_CURRENCY
  GENERIC
}

enum WalletServicePricingMode {
  PERCENTAGE
  FIXED_MARGIN
}

enum WalletEntryType {
  TOPUP
  SALE_DEDUCTION
  ADJUSTMENT
  REVERSAL
}

model DigitalWallet {
  id                  String          @id @default(cuid())
  name                String
  type                WalletType      @default(FLEXY)
  currency            String          @default("DZD")
  defaultSupplierId   String?
  lowBalanceThreshold String          @default("2000.00")
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  defaultSupplier     Contact?        @relation(fields: [defaultSupplierId], references: [id], onDelete: SetNull)
  services            WalletService[]
  ledgerEntries       WalletLedgerEntry[]
}

model WalletService {
  id                String                   @id @default(cuid())
  walletId          String
  name              String
  networkBrandColor String?
  commissionRate    String                   @default("0.0000")
  pricingMode       WalletServicePricingMode @default(PERCENTAGE)
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  wallet            DigitalWallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transactionItems  TransactionItem[]
  ledgerEntries     WalletLedgerEntry[]
}

model WalletLedgerEntry {
  id                String          @id @default(cuid())
  walletId          String
  entryType         WalletEntryType
  amount            String
  relatedPurchaseId String?
  relatedSaleId     String?
  balanceAfter      String
  notes             String?
  createdBy         String?
  createdAt         DateTime        @default(now())
  wallet            DigitalWallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  relatedPurchase   Transaction?    @relation("WalletPurchase", fields: [relatedPurchaseId], references: [id], onDelete: SetNull)
  relatedSale       Transaction?    @relation("WalletSale", fields: [relatedSaleId], references: [id], onDelete: SetNull)
  walletServiceId   String?
  nominalAmount     String?
  commissionProfit  String?
  beneficiaryPhone  String?
  walletService     WalletService?  @relation(fields: [walletServiceId], references: [id], onDelete: SetNull)
}

enum CustomerDebtEntryType {
  CREDIT_SALE
  CREDIT_REPAIR
  PAYMENT
  DEBT_ADJUSTMENT_ADD
  DEBT_ADJUSTMENT_SUB
  RETURN_CREDIT
}

model CustomerDebtLedgerEntry {
  id                      String                  @id @default(cuid())
  customerId              String
  type                    CustomerDebtEntryType
  amount                  String
  balanceBefore           String
  balanceAfter            String
  relatedTransactionId    String?
  relatedRepairTicketId   String?
  notes                   String?
  createdById             String?
  createdAt               DateTime                @default(now())
  customer                Contact                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  relatedTransaction      Transaction?            @relation(fields: [relatedTransactionId], references: [id], onDelete: SetNull)
  relatedRepairTicket     RepairTicket?           @relation(fields: [relatedRepairTicketId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([relatedTransactionId])
  @@index([relatedRepairTicketId])
}

enum SupplierDebtEntryType {
  CREDIT_PURCHASE
  PAYMENT
  DEBT_ADJUSTMENT_ADD
  DEBT_ADJUSTMENT_SUB
  PURCHASE_RETURN_DEBT
}

model SupplierDebtLedgerEntry {
  id                   String                @id @default(cuid())
  contactId            String
  type                 SupplierDebtEntryType
  amount               String
  balanceBefore        String
  balanceAfter         String
  relatedTransactionId String?
  notes                String?
  createdById          String?
  createdAt            DateTime              @default(now())
  contact              Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  relatedTransaction   Transaction?          @relation(fields: [relatedTransactionId], references: [id], onDelete: SetNull)

  @@index([contactId])
  @@index([relatedTransactionId])
}

enum ReturnCondition {
  RESTOCKED_INVENTORY
  DEFECTIVE_QUARANTINE
}

enum RefundMethod {
  CASH
  CUSTOMER_CREDIT_REDUCTION
  STORE_CREDIT
}

model SalesReturn {
  id                   String            @id @default(cuid())
  returnNumber         String            @unique
  originalTransactionId String
  customerId           String?
  refundAmount         String
  refundMethod         RefundMethod
  reason               String
  createdById          String?
  shiftId              String?
  createdAt            DateTime          @default(now())
  originalTransaction  Transaction       @relation(fields: [originalTransactionId], references: [id], onDelete: Restrict)
  customer             Contact?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items                SalesReturnItem[]

  @@index([originalTransactionId])
  @@index([customerId])
  @@index([createdAt])
}

model SalesReturnItem {
  id                String          @id @default(cuid())
  salesReturnId     String
  transactionItemId String
  inventoryItemId   String
  quantity          String
  unitPrice         String
  refundSubtotal    String
  condition         ReturnCondition
  serialNumber      String?
  createdAt         DateTime        @default(now())
  salesReturn       SalesReturn     @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  transactionItem   TransactionItem @relation(fields: [transactionItemId], references: [id], onDelete: Restrict)
  inventoryItem     Item            @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([salesReturnId])
  @@index([transactionItemId])
  @@index([inventoryItemId])
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StockCountScope {
  FULL_STORE
  CATEGORY
}

model StockCountSession {
  id                     String           @id @default(cuid())
  sessionNumber          String           @unique
  name                   String
  status                 StockCountStatus @default(IN_PROGRESS)
  scope                  StockCountScope  @default(FULL_STORE)
  categoryId             String?
  notes                  String?
  startedAt              DateTime         @default(now())
  completedAt            DateTime?
  totalItemsExpected     Int              @default(0)
  totalItemsCounted      Int              @default(0)
  totalDiscrepancyQty    Int              @default(0)
  totalFinancialVariance String           @default("0.00")
  items                  StockCountItem[]
  createdById            String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([status, createdAt])
}

model StockCountItem {
  id                 String           @id @default(cuid())
  sessionId          String
  session            StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  inventoryItemId    String
  inventoryItem      Item             @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  expectedQuantity   Int
  countedQuantity    Int              @default(0)
  differenceQuantity Int
  unitCost           String           @default("0.00")
  varianceValue      String           @default("0.00")
  notes              String?
  reconciled         Boolean          @default(false)
  updatedAt          DateTime         @updatedAt

  @@unique([sessionId, inventoryItemId])
  @@index([sessionId])
}

