generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ContactRole {
  SUPPLIER
  CUSTOMER
  BOTH
}

enum AccountRole {
  SUPPLIER
  CUSTOMER
}

model Contact {
  id        String         @id @default(cuid())
  name      String
  phone     String?
  address   String?
  role      ContactRole
  notes     String?
  isActive  Boolean        @default(true)
  isWalkIn  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  accounts  Account[]
  services  Service[]
  repairs   RepairTicket[]
}

model Account {
  id              String        @id @default(cuid())
  contactId       String
  role            AccountRole
  openingBalance  String        @default("0.00")
  currentBalance  String        @default("0.00")
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  contact         Contact       @relation(fields: [contactId], references: [id])
  transactions    Transaction[]
  ledgerEntries   LedgerEntry[]
  @@unique([contactId, role])
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model Item {
  id               String            @id @default(cuid())
  name             String
  description      String?
  sku              String?           @unique
  unit             String            @default("piece")
  costPrice        String            @default("0.00")
  sellingPrice     String            @default("0.00")
  minStock         Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  movements        StockMovement[]
  transactionLines TransactionItem[]
}

model StockMovement {
  id        String       @id @default(cuid())
  itemId    String
  type      MovementType
  quantity  Int
  note      String?
  reference String?
  createdAt DateTime     @default(now())
  item      Item         @relation(fields: [itemId], references: [id])
}

enum PricingType {
  FIXED
  COMMISSION
}

model Service {
  id               String               @id @default(cuid())
  name             String
  description      String?
  supplierId       String
  pricingType      PricingType
  fixedProfit      String?
  commissionPct    String?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  supplier         Contact              @relation(fields: [supplierId], references: [id])
  transactionLines TransactionService[]
}

enum TransactionType {
  SALE
  PURCHASE
  PAYMENT_IN
  PAYMENT_OUT
  OFFSET
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum CashMovementType {
  IN
  OUT
}

enum CashMovementCategory {
  SALE_PAYMENT
  PURCHASE_PAYMENT
  PAYMENT_IN
  PAYMENT_OUT
  EXPENSE
  OWNER_DRAW
  OWNER_DEPOSIT
  ADJUSTMENT
}

model Transaction {
  id             String               @id @default(cuid())
  type           TransactionType
  accountId      String
  amount         String
  amountPaidNow  String?              @default("0.00")
  note           String?
  reference      String?
  reversalOf     String?
  invoiceNumber  String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  account        Account              @relation(fields: [accountId], references: [id])
  ledgerEntries  LedgerEntry[]
  reversal       Transaction?         @relation("ReversalOf", fields: [reversalOf], references: [id])
  reversedBy     Transaction[]        @relation("ReversalOf")
  itemLines      TransactionItem[]
  serviceLines   TransactionService[]
}

model LedgerEntry {
  id            String          @id @default(cuid())
  transactionId String
  accountId     String
  entryType     LedgerEntryType
  amount        String
  balanceBefore String
  balanceAfter  String
  createdAt     DateTime        @default(now())
  transaction   Transaction     @relation(fields: [transactionId], references: [id])
  account       Account         @relation(fields: [accountId], references: [id])
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  itemId        String
  quantity      Int
  unitPrice     String
  unitCost      String      @default("0.00")
  totalPrice    String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  item          Item        @relation(fields: [itemId], references: [id])
}

model TransactionService {
  id            String      @id @default(cuid())
  transactionId String
  serviceId     String
  amount        String
  profit        String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  service       Service     @relation(fields: [serviceId], references: [id])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CashAccount {
  id             String         @id @default(cuid())
  currentBalance String         @default("0.00")
  updatedAt      DateTime       @updatedAt
  movements      CashMovement[]
}

model CashMovement {
  id                   String               @id @default(cuid())
  cashAccountId        String
  type                 CashMovementType
  category             CashMovementCategory
  amount               String
  balanceBefore        String
  balanceAfter         String
  note                 String?
  relatedTransactionId String?
  relatedExpenseId     String?
  createdAt            DateTime             @default(now())
  cashAccount          CashAccount          @relation(fields: [cashAccountId], references: [id])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]
}

model Expense {
  id          String          @id @default(cuid())
  categoryId  String
  amount      String
  description String?
  expenseDate DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
}

enum DeviceType {
  PHONE
  TABLET
  LAPTOP
  OTHER
}

enum RepairStatus {
  RECEIVED
  DIAGNOSING
  IN_REPAIR
  READY
  DELIVERED
  CANCELLED
}

enum RepairType {
  INTERNAL
  EXTERNAL
}

model RepairTicket {
  id                   String    @id @default(cuid())
  ticketNumber         String    @unique
  contactId            String
  deviceType           String
  deviceBrand          String
  deviceModel          String
  problemDescription   String
  status               String    @default("RECEIVED")
  repairType           String    @default("INTERNAL")
  technicianName       String?
  estimatedCost        String    @default("0.00")
  actualCost           String    @default("0.00")
  externalCost         String    @default("0.00")
  depositAmount        String    @default("0.00")
  depositPaid          Boolean   @default(false)
  invoiceNumber        String?   @unique
  relatedTransactionId String?
  notes                String?
  physicalCondition    String?
  hasPasscode          Boolean   @default(false)
  accessories          String?
  receivedAt           DateTime  @default(now())
  deliveredAt          DateTime?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  contact              Contact   @relation(fields: [contactId], references: [id])
}
