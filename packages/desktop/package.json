{
  "name": "@barakamobile/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "electron dist/main.js"
  },
  "dependencies": {
    "electron": "^33.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/electron": "^1.6.10",
    "tsx": "^4.7.0",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.barakamobile.app",
    "productName": "BarakaMobile",
    "target": "nsis",
    "directories": {
      "output": "../../dist-electron"
    },
    "files": [
      "dist/**",
      "../../packages/backend/dist/**",
      "../../packages/frontend/dist/**",
      "node_modules/**"
    ],
    "win": {
      "target": "nsis"
    }
  }
}